{
  "name": "scriptr-editor",
  "version": "0.1.0",
  "description": "Reusable rich-text editor primitives for Scripture-aware writing experiences.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "import": "./dist/document/index.js"
    },
    "./commands": {
      "types": "./dist/commands/index.d.ts",
      "import": "./dist/commands/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./scripture": {
      "types": "./dist/scripture/index.d.ts",
      "import": "./dist/scripture/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.19.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StartUpMediaUK/scriptr-editor.git"
  },
  "bugs": {
    "url": "https://github.com/StartUpMediaUK/scriptr-editor/issues"
  },
  "homepage": "https://github.com/StartUpMediaUK/scriptr-editor#readme",
  "keywords": [
    "editor",
    "rich-text",
    "scripture",
    "bible",
    "react"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node copy-styles.mjs",
    "budgets:check": "node check-budgets.mjs",
    "package:check": "pnpm build && publint && attw --pack --profile esm-only --exclude-entrypoints ./styles.css && node check-packed-package.mjs",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tiptap/core": "3.30.4",
    "@tiptap/extension-bubble-menu": "3.30.4",
    "@tiptap/extension-drag-handle-react": "3.30.4",
    "@tiptap/extension-floating-menu": "3.30.4",
    "@tiptap/extension-link": "3.30.4",
    "@tiptap/extension-placeholder": "3.30.4",
    "@tiptap/extension-task-item": "3.30.4",
    "@tiptap/extension-task-list": "3.30.4",
    "@tiptap/extension-underline": "3.30.4",
    "@tiptap/extension-unique-id": "3.30.4",
    "@tiptap/pm": "3.30.4",
    "@tiptap/react": "3.30.4",
    "@tiptap/starter-kit": "3.30.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "color": "^5.0.3",
    "lucide-react": "^1.43.0",
    "radix-ui": "^1.6.7",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/color": "^4.2.1",
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "3.2.4",
    "jsdom": "26.1.0",
    "publint": "0.3.12",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
